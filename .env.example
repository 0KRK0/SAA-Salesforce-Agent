# ---------------------------------------------------------------------------
# Salesforce AI Agent — example configuration. Copy to `.env` at the repo root
# (read by docker compose *and* by a local `uvicorn` run from backend/).
# NEVER commit a real .env file.
#
# Everything here is a DEPLOYMENT CEILING or a deployment-wide default. A
# project's own policy, set in the app, may be stricter than these values but
# never looser.
# ---------------------------------------------------------------------------

# --- App ---
ENVIRONMENT=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000
# API paths are versioned: everything is served under /api/v1.
API_PREFIX=/api
API_VERSION=v1

# --- Database ---
# Local default (no server needed):
DATABASE_URL=sqlite+aiosqlite:///./sfagent.db
# Postgres (docker compose default):
# DATABASE_URL=postgresql+asyncpg://sfagent:sfagent@db:5432/sfagent

# --- Session signing (change for anything but local dev) ---
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_SECONDS=43200

# ---------------------------------------------------------------------------
# Secrets at rest (REQUIRED)
#
# No credential is ever stored as a column value. The secret store issues a
# *reference* bound to the owning company, project and purpose; that reference
# is what lands in the database. A reference lifted out of one project's row
# cannot be resolved as another's.
#
#   local    Fernet, keyed by ENCRYPTION_KEY below. Real, and honest about the
#            key living in the application environment. Fine for development
#            and single-node deployments.
#   aws-kms  Envelope encryption. A per-secret data key is wrapped by KMS and
#            the master key never enters the application.
#
# vault, azure-key-vault and gcp-kms are NOT IMPLEMENTED. Selecting one fails
# at startup rather than silently storing secrets more weakly than you asked.
# ---------------------------------------------------------------------------
SECRET_BACKEND=local
# Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Only for SECRET_BACKEND=aws-kms
SECRET_KMS_KEY_ID=
SECRET_KMS_REGION=

# ---------------------------------------------------------------------------
# AI providers
#
# The platform is model-independent. These are the deployment-managed fallbacks
# used when a project has not brought its own key; a project's own BYOK
# credential always takes precedence and is stored through the secret store.
# ---------------------------------------------------------------------------
DEFAULT_LLM_PROVIDER=ANTHROPIC
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
# Model choice is configuration, never hardcoded. Empty falls back to the
# provider's own default for that tier.
LLM_FAST_MODEL=
LLM_BALANCED_MODEL=
LLM_ADVANCED_MODEL=

ANTHROPIC_API_KEY=
# Back-compatible alias used by existing deployments.
CLAUDE_MODEL=claude-sonnet-4-5

# Optional additional providers.
OPENAI_API_KEY=
OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
GOOGLE_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# For Bedrock; credentials come from the standard AWS chain, never from here.
AWS_REGION=

# --- Agent runtime limits (cost + runaway-loop control) ---
MAX_AGENT_STEPS=20
MAX_TOOL_CALLS=120
MAX_EXECUTION_SECONDS=1800
MAX_TOOL_RESULT_CHARS=20000
MAX_QUERY_ROWS=500
DEFAULT_QUERY_LIMIT=200
TOOL_TIMEOUT_SECONDS=90
# Deployments, Apex test runs and bulk jobs get their own ceiling.
LONG_TOOL_TIMEOUT_SECONDS=900

# --- Approval policy (deployment-wide CEILINGS) ---
APPROVAL_TTL_SECONDS=3600
# Separation of duties: the requester may not approve their own HIGH-risk
# change. Off by default because it deadlocks a single-operator deployment;
# turn it on for any team of more than one. CRITICAL changes — irreversible
# deletion against production — always require a separate approver regardless.
REQUIRE_SEPARATE_APPROVER=false
# Refuse a data mutation affecting more rows than this.
MAX_BULK_RECORDS=50000
# Rows a data-quality scan may pull into the analyzer (never into the model).
MAX_ANALYSIS_RECORDS=20000

# --- Durable execution ---
# Runs are owned by the server, never by a browser connection: closing a tab
# does not stop work, and reopening one resumes the stream.
RUN_WORKER_ENABLED=true
RUN_WORKER_CONCURRENCY=4
RUN_HEARTBEAT_TIMEOUT_SECONDS=120
WORKER_ID=

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=300
RATE_LIMIT_RUN_START_PER_MINUTE=20

# --- MCP tool providers ---
MCP_ENABLED=true
MCP_CONNECT_TIMEOUT_SECONDS=20
MCP_CALL_TIMEOUT_SECONDS=120
# An MCP server describes its own tools; that is a claim, not evidence, so no
# MCP tool is ever classified below this floor.
MCP_DEFAULT_RISK=MEDIUM

# --- Enterprise identity (optional) ---
# Setting an issuer enables OIDC single sign-on at /api/v1/auth/oidc/start.
# SAML is NOT implemented — see docs/security.md.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/oidc/callback
OIDC_SCOPES=openid email profile
# SCIM 2.0 Users provisioning. Empty disables the endpoints entirely.
SCIM_BEARER_TOKEN=

# ---------------------------------------------------------------------------
# Salesforce OAuth client
#
# These are the DEPLOYMENT-MANAGED fallback app: one External Client App used
# by any company that has not registered its own. A company's own app —
# configured in the UI under Settings, held in the secret store — always wins.
#
# A Connected App is the customer's security control, not ours: it decides
# which profiles may reach their org, from which IP ranges, and carries the
# button that revokes every session. One shared app across every tenant means
# one customer's revocation takes every other customer offline with it. So
# leaving these blank is a legitimate configuration: each company brings its
# own app through the UI.
#
# New Connected Apps cannot be created by default since Spring '26 — use an
# External Client App. See docs/salesforce.md.
# ---------------------------------------------------------------------------
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# Where this backend is reachable from a browser. The Salesforce callback URL
# is DERIVED from it, so it cannot drift out of step with the route that is
# actually served — a callback missing the `/v1` segment sends a person all the
# way through a successful Salesforce login and drops them on a 404 holding a
# valid authorization code.
PUBLIC_BASE_URL=http://localhost:8000
# Legacy override. Leave EMPTY unless you must pin an exact string; when set it
# is validated at startup against the route that exists, and a mismatch is
# logged as an error and refused before any redirect.
SALESFORCE_REDIRECT_URI=
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_API_VERSION=62.0
SALESFORCE_SCOPES=api refresh_token offline_access

# Metadata deployments to production orgs are blocked unless this is true.
# It is a ceiling: a project must ALSO enable production mutations in policy.
ALLOW_PRODUCTION_MUTATIONS=false

# --- External systems (optional; each is a real OAuth app when configured) ---
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Feature flags
#
# A feature that is off is not advertised as available anywhere in the UI. This
# is how the product avoids showing a "Connected" state for something that is
# not built.
# ---------------------------------------------------------------------------
FEATURE_SAML=false
FEATURE_SCIM=true
FEATURE_JIRA=true
FEATURE_GITHUB=true
FEATURE_BITBUCKET=true
FEATURE_MCP=true
FEATURE_PRODUCTION_DEPLOYMENT=false
FEATURE_PLATFORM_MANAGED_AI=false
FEATURE_BILLING=false
# Let each company register its own Salesforce External Client App in the UI.
FEATURE_CUSTOMER_SALESFORCE_APPS=true
# Require it — no company falls back to the deployment's shared app.
FEATURE_REQUIRE_CUSTOMER_SALESFORCE_APP=false

# --- Frontend (frontend/.env.local) ---
# NEXT_PUBLIC_API_BASE=http://localhost:8000
